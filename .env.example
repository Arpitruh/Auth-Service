# ---- Core ----
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Prisma + pg driver adapter).
# For Neon, prefer the pooled host (…-pooler…) for serverless workloads.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- JWT ----
# Use long, random values in production. Rotate by moving the current value to
# the *_PREVIOUS var so existing tokens verify during the grace window.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_PREVIOUS=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- CORS / cookies ----
CLIENT_ORIGIN=http://localhost:3000
REFRESH_COOKIE_NAME=refreshToken

# ---- Redis (optional) ----
# When unset, an in-memory fallback is used (single-instance only; NOT safe for
# horizontal scaling). Provide a URL to use shared Redis across instances.
# REDIS_URL=redis://localhost:6379

# ---- Password policy ----
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true

# ---- Rate limiting (per IP+email) ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# ---- Account lockout (per email) ----
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=15

# ---- Password reset ----
RESET_TOKEN_TTL_MINUTES=30

# ---- Database pool ----
DB_POOL_SIZE=10

# ---- Logging ----
LOG_LEVEL=info
